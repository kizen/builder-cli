{
  "id": "e0a255d1-ec9d-40f2-b9a4-643ccaf49491",
  "name": "Manual Review Activity Complete",
  "api_name": "manual_review_activity_complete",
  "ai_description": "\nWhen a 'Document Classification Review - Manual Review' activity is logged on a Document Sets record, or when triggered manually, this 9-step automation finalizes the manual classification process. The workflow begins by initializing several variables for tracking, including the record, parent, and execution IDs. An LLM then generates an updated classification reason by prepending the text \"Classified Manually - Previous Classification Reasoning: \" to the existing reason on the record. The automation proceeds to update three fields on the Document Sets record: it sets the 'Document Classification Status' to 'Classified', updates the 'Classification Reason' with the LLM-generated text, and changes the 'Classification Confidence' to 'Manually Reviewed'. Finally, it schedules a 'Document Classification Review - Classified/Override' activity, assigns it to a team member via round-robin, and executes a Python code step.\n",
  "active": true,
  "type": "record_based",
  "custom_object": {
    "id": "8fa0a1cb-8d96-4ec4-9bbf-7ace6dd5a574",
    "name": "document_sets",
    "description": "The Document Sets object stores and categorizes financial documents for mortgage transactions, classifying them by type like 'Appraisal' or 'W2'. It tracks classification status, records an execution date, and identifies multi-document files. Each set is linked to a primary Deal, Party, and Contact, and supports parent-child hierarchies for grouping related documents.",
    "entity_name": "Document",
    "object_name": "Document Sets",
    "object_class": "custom_objects",
