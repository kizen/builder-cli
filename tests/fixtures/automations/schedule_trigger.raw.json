            "conflict_resolution": "overwrite",
            "create_missing_option": false,
            "data_type": "string",
            "is_list": false
          }
        ],
        "script": "import requests\nimport json\n\nBASE_URL = \"https://app.go.kizen.com/api\"\n\nbusiness_id, user_id, api_key = secrets[\"kizen_api\"].split(\":\")\n\ns = requests.Session()\ns.headers.update(\n    {\n        \"X-BUSINESS-ID\": business_id,\n        \"X-USER-ID\": user_id,\n        \"X-API-KEY\": api_key,\n        \"accept\": \"application/json\",\n        \"Content-Type\": \"application/json\",\n    }\n)\n\nTAX_LOT_OBJECT = \"tax_lot\"\nTICKER_FIELD = \"ticker_symbol\"\n\npage = 1\npage_size = 100\nticker_records = {}  # { \"VTI\": [\"uuid1\", \"uuid2\"], \"BND\": [\"uuid3\"] }\n\nwhile True:\n    resp = s.post(\n        f\"{BASE_URL}/records/{TAX_LOT_OBJECT}/search\",\n        params={\"page\": page, \"page_size\": page_size},\n        json={\n            \"field_names\": [TICKER_FIELD],\n            \"query\": [],\n            \"and\": True,\n        },\n    )\n    resp.raise_for_status()\n    data = resp.json()\n\n    outputs.log(f\"Page {page}: {len(data.get('results', []))} results\")\n\n    for record in data.get(\"results\", []):\n        record_id = record[\"id\"]\n        for field in record.get(\"fields\", {}).values():\n            if field.get(\"name\") == TICKER_FIELD:\n                val = field.get(\"value\")\n                if val:\n                    ticker = val.strip().upper()\n                    ticker_records.setdefault(ticker, []).append(record_id)\n\n    if not data.get(\"next\"):\n        break\n    page += 1\n\noutputs.log(f\"Found tickers: {sorted(ticker_records.keys())}\")\noutputs.ticker_list = json.dumps(sorted(ticker_records.keys()))\noutputs.ticker_records = json.dumps(ticker_records)"
      },
      "action_on_failure": "silent_continue",
      "should_skip_execution": false,
      "error_notification_severity_level": "inherit"
    },
