          }
        ],
        "script": "# Step 2 - Fetch prices from Yahoo Finance\nimport requests\nimport json\n\ntickers = json.loads(inputs.ticker_list)\n\nprices = {}\n\nfor ticker in tickers:\n    try:\n        url = \"https://query1.finance.yahoo.com/v8/finance/chart/\" + ticker\n        resp = requests.get(\n            url,\n            params={\"interval\": \"1d\", \"range\": \"1d\"},\n            headers={\"User-Agent\": \"Mozilla/5.0\"},\n            timeout=10,\n        )\n        resp.raise_for_status()\n        data = resp.json()\n        close = data[\"chart\"][\"result\"][0][\"meta\"][\"regularMarketPrice\"]\n        prices[ticker] = round(float(close), 4)\n        outputs.log(f\"{ticker}: {prices[ticker]}\")\n    except Exception as e:\n        outputs.log(f\"{ticker}: failed - {e}\")\n        prices[ticker] = None\n\noutputs.price_map = json.dumps(prices)"
      },
