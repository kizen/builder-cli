        "script": "import requests\nimport json\n\nBASE_URL = \"https://app.go.kizen.com/api\"\n\nbusiness_id, user_id, api_key = secrets[\"kizen_api\"].split(\":\")\n\ns = requests.Session()\ns.headers.update(\n    {\n        \"X-BUSINESS-ID\": business_id,\n        \"X-USER-ID\": user_id,\n        \"X-API-KEY\": api_key,\n        \"accept\": \"application/json\",\n        \"Content-Type\": \"application/json\",\n    }\n)\n\nTAX_LOT_OBJECT = \"tax_lot\"\nPRICE_FIELD = \"current_value\"\n\nticker_records = json.loads(inputs.ticker_records)  # { \"VTI\": [\"uuid1\", ...], ... }\nprices = json.loads(inputs.price_map)\n\nupdated = 0\nskipped = 0\nerrors = []\n\nfor ticker, record_ids in ticker_records.items():\n    price = prices.get(ticker)\n    if price is None:\n        outputs.log(f\"{ticker}: no price, skipping {len(record_ids)} records\")\n        skipped += len(record_ids)\n        continue\n\n    for record_id in record_ids:\n        update_resp = s.patch(\n            f\"{BASE_URL}/records/{TAX_LOT_OBJECT}/{record_id}\",\n            json={\n                \"fields\": [\n                    {\n                        \"name\": PRICE_FIELD,\n                        \"value\": price,\n                    }\n                ]\n            },\n        )\n        if update_resp.ok:\n            updated += 1\n            outputs.log(f\"{ticker} record {record_id}: updated to {price}\")\n        else:\n            errors.append(\n                {\n                    \"record_id\": record_id,\n                    \"ticker\": ticker,\n                    \"status\": update_resp.status_code,\n                    \"detail\": update_resp.text[:200],\n                }\n            )\n            outputs.log(f\"{ticker} record {record_id}: ERROR {update_resp.status_code}\")\n\noutputs.log(f\"Done: {updated} updated, {skipped} skipped, {len(errors)} errors\")\noutputs.update_summary = json.dumps(\n    {\n        \"updated\": updated,\n        \"skipped_no_price\": skipped,\n        \"errors\": errors,\n    }\n)"
